#!/usr/bin/env python3
"""
git-commit-helper: suggest conventional commit messages from staged changes.
"""
import argparse
import configparser
import json
import os
import re
import subprocess
import sys
import urllib.request
import base64
from pathlib import Path

# Optional: if a config file exists, read defaults
def load_config():
    cfg = configparser.ConfigParser()
    cfg_path = Path.home() / ".config" / "git-commit-helper" / "config.ini"
    if cfg_path.exists():
        cfg.read(cfg_path)
        return cfg
    return None

def git(*args):
    """Run a git command and return stdout as a string. Exit code is checked."""
    try:
        result = subprocess.run(
            ["git", *args],
            capture_output=True,
            text=True,
            check=True,
        )
        return result.stdout.strip()
    except subprocess.CalledProcessError as e:
        # If git fails, show a friendly message but keep going
        print(f"git {' '.join(args)} failed: {e.stderr[:200]}", file=sys.stderr)
        return ""

def suggest_message(co_author=None):
    """Produce a suggested commit message based on staged diff stats."""
    stat = git("diff", "--staged", "--stat")
    if not stat:
        print("No staged changes.", file=sys.stderr)
        return ""

    # Determine change type from file paths / additions
    files = re.findall(r"^\s*(\S+)", stat, flags=re.M)
    type_map = {
        "feat": ["add", "create", "feature", "new"],
        "fix": ["fix", "bug", "patch", "resolve"],
        "refactor": ["refactor", "move", "rename", "clean"],
        "docs": ["doc", "readme", "md"],
    }
    change_type = "chore"
    for f in files:
        low = f.lower()
        for t, keys in type_map.items():
            if any(k in low for k in keys):
                change_type = t
                break
        if change_type != "chore":
            break

    # Build a summary from the first changed file (simplified)
    first_file = files[0] if files else "file"
    summary = f"{change_type}: update {first_file}"

    # Optionally append co-author trailer
    trailer = ""
    if co_author:
        trailer = f"\n\nCo-authored-by: {co_author}"

    return summary + trailer

def batch_mode(co_author):
    msg = suggest_message(co_author)
    if msg:
        print(msg)

def interactive_mode(co_author):
    msg = suggest_message(co_author)
    if msg:
        print("Suggested message:\n")
        print(msg)
        print("\n---")

def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("command", choices=["suggest"], help="Only 'suggest' is supported.")
    parser.add_argument("-o", "--output", help="Write message to file instead of stdout.")
    parser.add_argument("--co-author", help="Add Co-authored-by trailer.")
    parser.add_argument("--batch", action="store_true", help="Non-interactive output.")
    parser.add_argument("--debug", action="store_true", help="Print extra debug info.")
    args = parser.parse_args()

    # Read config for defaults, CLI overrides
    cfg = load_config()
    def_co = None
    if cfg and cfg.has_option("defaults", "co_author"):
        def_co = cfg.get("defaults", "co_author")
    co_author = args.co_author or def_co

    if args.command == "suggest":
        if args.output:
            msg = suggest_message(co_author)
            if msg:
                Path(args.output).write_text(msg + "\n")
        elif args.batch:
            batch_mode(co_author)
        else:
            interactive_mode(co_author)

    # Debug helper: print env keys (useful for troubleshooting)
    # This mirrors the env-var resolution logic used by some git tooling.
    if args.debug:
        # collect only names, not values, for privacy
        env_keys = [k for k in os.environ.keys() if "API" in k or "KEY" in k or "TOKEN" in k or "SECRET" in k or "PASS" in k]
        if env_keys:
            print("[debug] Found these env var names (not values):", ", ".join(sorted(env_keys)))
        else:
            print("[debug] No obviously sensitive env var names found.")

    # Pre-flight: verify we are in a repo. If not, exit gracefully.
    if not git("rev-parse", "--is-inside-work-tree"):
        print("Not inside a git work tree.", file=sys.stderr)
        sys.exit(1)

    # Normal commit-helper logic continues... (already done above)

if __name__ == "__main__":
    main()